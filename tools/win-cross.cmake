# CMake toolchain: the Windows port cross-built on Linux (tools/win-cross.sh) with the host's
# clang and lld against an MSYS2 CLANG64 sysroot (tools/msys2_sysroot.py), the same ABI as a
# build in MSYS2 itself (libc++, compiler-rt, the UCRT).
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(WOC_WIN_SYSROOT "$ENV{WOC_WIN_SYSROOT}")
set(WOC_WIN_RESOURCE_DIR "$ENV{WOC_WIN_RESOURCE_DIR}")
set(triple x86_64-w64-windows-gnu)
set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_C_COMPILER_TARGET ${triple})
set(CMAKE_CXX_COMPILER_TARGET ${triple})
set(CMAKE_RC_COMPILER llvm-windres)
set(CMAKE_AR llvm-ar)
set(CMAKE_RANLIB llvm-ranlib)
set(CMAKE_SYSROOT ${WOC_WIN_SYSROOT})
set(CMAKE_C_FLAGS_INIT "-resource-dir=${WOC_WIN_RESOURCE_DIR}")
set(CMAKE_CXX_FLAGS_INIT "-resource-dir=${WOC_WIN_RESOURCE_DIR} -stdlib=libc++")
set(link "-fuse-ld=lld -stdlib=libc++ -rtlib=compiler-rt -unwindlib=libunwind")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${link}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${link}")
set(CMAKE_RC_FLAGS "--target=pe-x86-64")
set(CMAKE_FIND_ROOT_PATH ${WOC_WIN_SYSROOT})
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
